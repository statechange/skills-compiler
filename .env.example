# A GitHub personal access token.
#
# Optional but strongly recommended: unauthenticated requests to the GitHub
# API are capped at ~60/hour per IP, which is easy to hit. An authenticated
# token lifts that to ~5,000/hour.
#
# A fine-grained PAT with "Contents: Read" on the repos you care about (or
# "Public repositories (read-only)") is enough. No write scopes needed.
#
# Copy this file to .env.local and fill in the token:
#     cp .env.example .env.local
GITHUB_TOKEN=
